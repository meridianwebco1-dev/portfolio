generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  projectType String
  budget      String
  details     String
  createdAt   DateTime @default(now())
}
